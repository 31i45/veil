# ─── IDE / editor local configs ───
.vscode/
.idea/
*.code-workspace

# ─── OS / shell artifacts ───
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Git lock files (sometimes leftover) ───
.git/index.lock
.git/packed-refs.lock
.git/AUTO_MERGE.lock

# ─── Rust / Cargo ───
target/
**/*.rs.bk
Cargo.lock.bak

# ─── Trae / AI agent intermediate artifacts ───
.trae/skills/
.trae/documents/
.trae/specs/drive-v1-excellence/
.trae/specs/v1-progress-review-and-roadmap/
.trae/specs/own-line-layout-policy/

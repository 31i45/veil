# ─── IDE / editor local configs ───
.vscode/
.idea/
*.code-workspace

# ─── OS / shell artifacts ───
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Git lock files (sometimes leftover) ───
.git/index.lock
.git/packed-refs.lock
.git/AUTO_MERGE.lock

# ─── Rust / Cargo ───
target/
**/*.rs.bk
Cargo.lock.bak

# ─── Throwaway prototypes (非 workspace 成员，仅本地实验) ───
spikes/

# ─── Trae / AI agent intermediate artifacts ───
# 整个 .trae/ 不入库，唯一例外是 release-and-roadmap（v1.1/v2.0 长期路线图）。
.trae/*
!.trae/specs/
.trae/specs/*
!.trae/specs/release-and-roadmap/

# ─── ai-dev-skills local instantiation ───
.skills/

# ─── Build / release artifacts ───
release-bundle/
veil-artifact/
veil-windows-x86_64.zip

# ─── Benchmark corpus / results (可由 tools/bench/gen_corpus.py 再生，不入库) ───
bench/corpus/
bench/results/

# ─── Local UI snapshots ───
.screenshots/

# ─── Real-device walkthrough evidence (PNG screenshots, local only) ───
docs/review/evidence/**/*.png
docs/review/evidence/**/*.jpg

# ─── Local editor caches ───
*.swp
*.swo
*~
